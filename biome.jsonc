{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    // "ultracite/biome/react",
    // "ultracite/biome/tanstack",
    // "ultracite/biome/vitest",
    "ultracite/biome/nestjs"
    // "ultracite/biome/jest"
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        },
        "useExhaustiveDependencies": "off"
      },
      // "suspicious": {
      //   "noLeakedRender": "off",
      //   "noAsyncPromiseExecutor": "off",
      //   "useAwait": "off",
      //   "noExplicitAny": "off",
      //   "noShadow": "off"
      // },
      "suspicious": "off",
      "performance": "off",
      "security": "off",
      "style": {
        "useTemplate": "off",
        "useDestructuring": "off",
        "useImportType": "off",
        "useReadonlyClassProperties": "off",
        "useConsistentTypeDefinitions": "off",
        "noNestedTernary": "off",
        "useNodejsImportProtocol": {
          "level": "error",
          "fix": "safe"
        },
        "useAtIndex": {
          "level": "error",
          "fix": "safe"
        },
        "noNonNullAssertion": {
          "level": "error",
          "fix": "safe"
        }
      },
      "a11y": "off",
      "complexity": "off"
    }
  }
}
